# Copy to .env and fill in LLM_API_KEY.
#
# Defaults target Groq (fast, free tier, good tool calling). Get a key at
# https://console.groq.com/keys

LLM_API_KEY=

# Optional overrides (defaults shown):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_CUSTOMER_MODEL=openai/gpt-oss-120b   # simulated customer in `python -m evals --llm`
#
# List models your Groq account can use:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $LLM_API_KEY"

# --- Other providers (set LLM_BASE_URL + LLM_MODEL to match) -----------------
# OpenAI:   LLM_BASE_URL=  (blank)                      LLM_MODEL=gpt-4o-mini
# Together: LLM_BASE_URL=https://api.together.xyz/v1    LLM_MODEL=Qwen/Qwen2.5-72B-Instruct-Turbo
# Ollama:   LLM_BASE_URL=http://localhost:11434/v1     LLM_MODEL=qwen2.5:7b   (LLM_API_KEY=ollama)

# Flask session cookie signing (web UI). A dev default is used if unset.
# SECRET_KEY=change-me
